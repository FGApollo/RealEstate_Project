# Biến môi trường của FRONTEND (Vite). Sao chép thành `.env` ở thư mục gốc.
# Mọi biến VITE_* đều bị đóng gói vào mã gửi xuống trình duyệt: chỉ đặt giá trị CÔNG KHAI ở đây.
# Không bao giờ đặt secret key của Supabase, JWT_SECRET hay key payOS trong file này (xem server/.env.example).

VITE_API_URL=http://localhost:3000
VITE_GOOGLE_CLIENT_ID=

# Project Supabase (chỉ dùng cho kênh Realtime báo tin nhắn mới; trình duyệt không đọc bảng nào).
VITE_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_…), Dashboard → Project Settings → API Keys.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Google Analytics (tùy chọn)
VITE_GA_MEASUREMENT_ID=
VITE_GA_HOSTNAME=
