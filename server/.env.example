# ==========================================
# CẤU HÌNH SERVER & BẢO MẬT
# ==========================================
PORT=3000
# Render runs behind its load balancer. Keep local development at 0; set 1 on
# Render unless the service has an additional trusted proxy hop.
TRUST_PROXY_HOPS=0
# Development origins only. Set the exact production origin in Render using
# CORS_ALLOWED_ORIGINS; add preview origins only to a separate staging service.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SAME_SITE=lax

# Rate-limit tuning (defaults are defined in middleware/rateLimiters.js).
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
AUTH_IP_RATE_LIMIT_MAX=60
LOGIN_IP_EMAIL_RATE_LIMIT_MAX=8
REGISTER_IP_RATE_LIMIT_MAX=10
REGISTER_IP_EMAIL_RATE_LIMIT_MAX=3
GOOGLE_LOGIN_IP_RATE_LIMIT_MAX=20
WRITE_RATE_LIMIT_MAX=60
MESSAGE_RATE_LIMIT_MAX=30
OTP_SEND_IP_RATE_LIMIT_MAX=8
OTP_SEND_USER_RATE_LIMIT_MAX=5
OTP_VERIFY_IP_RATE_LIMIT_MAX=30
OTP_VERIFY_USER_RATE_LIMIT_MAX=10
EXPENSIVE_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=10
# Required before ESMS_SANDBOX=0 can send real SMS. Set these from product policy
# and the ESMS account budget; live sending fails closed if either is unset.
OTP_SEND_MAX_PER_PHONE_PER_HOUR=
OTP_SEND_MAX_PER_PHONE_PER_DAY=
OTP_SEND_MAX_GLOBAL_PER_DAY=

# JWT Configuration
JWT_SECRET=replace-with-at-least-32-random-bytes-generated-by-a-secret-manager
JWT_ISSUER=swipenest-api
JWT_AUDIENCE=swipenest-web

# ==========================================
# CẤU HÌNH SUPABASE & GOOGLE
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id

# ==========================================
# CẤU HÌNH eSMS.vn (DỊCH VỤ GỬI TIN NHẮN SMS OTP)
# Đăng ký tài khoản và lấy key tại: https://esms.vn
# ==========================================
# ApiKey và SecretKey do eSMS cung cấp trong mục "Quản lý API"
ESMS_API_KEY=
ESMS_SECRET_KEY=

# Tên Brandname đã đăng ký với eSMS (mặc định thử nghiệm: Baotrixemay)
ESMS_BRANDNAME=SwipeNest

# Loại tin nhắn:
# 2 = Tin nhắn CSKH hiển thị Brandname (khuyên dùng cho OTP)
# 8 = Tin nhắn đầu số cố định 10 số (giá rẻ)
ESMS_SMS_TYPE=2

# Bật/tắt chế độ thử nghiệm của eSMS:
# 1 = Gửi Sandbox (chế độ test không trừ tiền, kiểm tra API)
# 0 = Gửi SMS thật đến điện thoại
ESMS_SANDBOX=1

# Định dạng tiếng Việt: 0 = Không dấu (khuyên dùng), 1 = Có dấu (Unicode)
ESMS_IS_UNICODE=0

# Mẫu nội dung tin nhắn gửi qua SMS (dùng {otp} để thay thế mã OTP)
ESMS_OTP_TEMPLATE="Ma OTP xac thuc cua ban tai SwipeNest la: {otp}. Ma co hieu luc trong 5 phut. Vui long khong chia se ma nay cho bat ky ai."

# Nếu chưa cấu hình ESMS_API_KEY hoặc đặt ESMS_MOCK=true,
# hệ thống sẽ tự động in mã OTP ra console/terminal để test dev.
ESMS_MOCK=false
