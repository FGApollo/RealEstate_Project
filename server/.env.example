# ==========================================
# CẤU HÌNH SERVER & BẢO MẬT
# ==========================================
PORT=3000
# Render runs behind its load balancer. Keep local development at 0; set 1 on
# Render unless the service has an additional trusted proxy hop.
TRUST_PROXY_HOPS=0
# Development origins only. Set the exact production origin in Render using
# CORS_ALLOWED_ORIGINS; add preview origins only to a separate staging service.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_COOKIE_SAME_SITE=lax

# Máy dev không có Gmail / eSMS: in liên kết xác minh email và mã OTP ra terminal của server
# thay vì gửi thật, để chạy được luồng đăng ký và xác minh số điện thoại. Chỉ có tác dụng khi
# NODE_ENV=development (hoặc test); production không bao giờ bật được.
# NODE_ENV=development
# DEV_CONSOLE_DELIVERY=true

# Rate-limit tuning (defaults are defined in middleware/rateLimiters.js).
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
AUTH_IP_RATE_LIMIT_MAX=60
LOGIN_IP_EMAIL_RATE_LIMIT_MAX=8
REGISTER_IP_RATE_LIMIT_MAX=10
REGISTER_IP_EMAIL_RATE_LIMIT_MAX=3
EMAIL_VERIFICATION_SEND_WINDOW_MS=3600000
EMAIL_VERIFICATION_SEND_COOLDOWN_MS=60000
EMAIL_VERIFICATION_SEND_COOLDOWN_MAX=1
EMAIL_VERIFICATION_SEND_IP_MAX=10
EMAIL_VERIFICATION_SEND_IP_EMAIL_MAX=5
EMAIL_VERIFICATION_VERIFY_IP_MAX=30
GOOGLE_LOGIN_IP_RATE_LIMIT_MAX=20
WRITE_RATE_LIMIT_MAX=60
MESSAGE_RATE_LIMIT_MAX=30
OTP_SEND_IP_RATE_LIMIT_MAX=8
OTP_SEND_USER_RATE_LIMIT_MAX=5
OTP_VERIFY_IP_RATE_LIMIT_MAX=30
OTP_VERIFY_USER_RATE_LIMIT_MAX=10
EXPENSIVE_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=10
# Required before ESMS_SANDBOX=0 can send real SMS. Set these from product policy
# and the ESMS account budget; live sending fails closed if either is unset.
OTP_SEND_MAX_PER_PHONE_PER_HOUR=
OTP_SEND_MAX_PER_PHONE_PER_DAY=
OTP_SEND_MAX_GLOBAL_PER_DAY=

# JWT Configuration
JWT_SECRET=replace-with-at-least-32-random-bytes-generated-by-a-secret-manager
JWT_ISSUER=swipenest-api
JWT_AUDIENCE=swipenest-web

# ==========================================
# CẤU HÌNH SUPABASE & GOOGLE
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
# Khóa bí mật của project (Dashboard → Project Settings → API Keys → Secret key, dạng sb_secret_…).
# CHỈ đặt trong server/.env. Không bao giờ đặt trong .env gốc hay dưới tên VITE_* (sẽ lộ ra trình duyệt).
# Backend từ chối khởi động nếu đây là khóa publishable/anon. Tên cũ SUPABASE_SERVICE_ROLE_KEY vẫn được chấp nhận.
SUPABASE_SECRET_KEY=sb_secret_replace-me
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id

# Gmail API OAuth sender for email verification. Keep all values server-side.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Exact public frontend origin; the backend builds /verify-email links from this value.
FRONTEND_URL=https://your-frontend.example.com

# ==========================================
# CẤU HÌNH eSMS.vn (DỊCH VỤ GỬI TIN NHẮN SMS OTP)
# Đăng ký tài khoản và lấy key tại: https://esms.vn
# ==========================================
# ApiKey và SecretKey do eSMS cung cấp trong mục "Quản lý API"
ESMS_API_KEY=
ESMS_SECRET_KEY=

# Tên Brandname đã đăng ký với eSMS (mặc định thử nghiệm đã duyệt sẵn: Baotrixemay)
ESMS_BRANDNAME=Baotrixemay

# Loại tin nhắn:
# 2 = Tin nhắn CSKH hiển thị Brandname (khuyên dùng, Baotrixemay đã duyệt sẵn)
# 8 = Tin nhắn đầu số cố định 10 số (Cố định giá rẻ)
ESMS_SMS_TYPE=2

# Bật/tắt chế độ thử nghiệm của eSMS:
# 1 = Gửi Sandbox (chế độ test không trừ tiền, kiểm tra API)
# 0 = Gửi SMS thật đến điện thoại
ESMS_SANDBOX=0

# Định dạng tiếng Việt: 0 = Không dấu (khuyên dùng), 1 = Có dấu (Unicode)
ESMS_IS_UNICODE=0

# Mẫu nội dung tin nhắn gửi qua SMS:
# - Với Brandname Baotrixemay thử nghiệm (đã duyệt sẵn 100% trên 5 nhà mạng):
#   ESMS_OTP_TEMPLATE="{otp} la ma xac minh dang ky Baotrixemay cua ban"
# - Với SmsType=8 (Đầu số cố định giá rẻ):
#   ESMS_OTP_TEMPLATE="Ma OTP cua ban la {otp}"
ESMS_OTP_TEMPLATE="{otp} la ma xac minh dang ky Baotrixemay cua ban"

# Mock chỉ dành cho local/test; không ghi mã OTP ra log.
# Production bắt buộc có credentials, ESMS_MOCK=false, ESMS_SANDBOX=0
# và đầy đủ các giới hạn gửi OTP đã mô tả ở trên.
ESMS_MOCK=false

# Identity checks fail closed unless a real Face++ provider is configured.
KYC_FACE_MATCH_PROVIDER=facepp
FACEPP_API_KEY=
FACEPP_API_SECRET=
FACEPP_API_URL=https://api-us.faceplusplus.com/facepp/v3/compare
# Chế độ demo so khớp khuôn mặt cho máy dev (không có key Face++): đặt đủ 3 biến
#   NODE_ENV=development
#   KYC_ALLOW_DEMO=true
#   KYC_FACE_MATCH_PROVIDER=demo
# Tùy chọn KYC_FACE_MATCH_DEMO_RESULT=pass|fail để ép kết quả. Nếu không cấu hình provider nào,
# selfie luôn thất bại và hồ sơ phải chờ admin duyệt tay.
# Demo approvals require BOTH NODE_ENV=development|test and this explicit flag.
# Never enable demo identity verification on a deployed service.
KYC_ALLOW_DEMO=false

# Agent Premium payments. Backend only; never use a VITE_ prefix for these keys.
# Keep false until migrations 014/015 and the channel webhook are ready.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# FRONTEND_URL above is also the exact origin for payOS return/cancel URLs.
